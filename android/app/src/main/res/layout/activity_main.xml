<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp">

        <TextView
            style="@style/Title"
            android:text="@string/app_name" />

        <TextView
            style="@style/Body"
            android:text="@string/tagline" />

        <!-- Setup checklist -->
        <TextView
            style="@style/Section"
            android:text="@string/section_setup" />

        <LinearLayout style="@style/Row">
            <TextView
                android:id="@+id/micStatus"
                style="@style/RowText" />
            <Button
                android:id="@+id/micButton"
                style="@style/RowButton"
                android:text="@string/grant" />
        </LinearLayout>

        <LinearLayout style="@style/Row">
            <TextView
                android:id="@+id/a11yStatus"
                style="@style/RowText" />
            <Button
                android:id="@+id/a11yButton"
                style="@style/RowButton"
                android:text="@string/open_settings" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/restrictedRow"
            style="@style/Row">
            <TextView
                style="@style/RowText"
                android:text="@string/a11y_restricted_hint"
                android:textSize="13sp" />
            <Button
                android:id="@+id/appInfoButton"
                style="@style/RowButton"
                android:text="@string/app_info" />
        </LinearLayout>

        <LinearLayout style="@style/Row">
            <TextView
                android:id="@+id/batteryStatus"
                style="@style/RowText" />
            <Button
                android:id="@+id/batteryButton"
                style="@style/RowButton"
                android:text="@string/open_settings" />
        </LinearLayout>

        <LinearLayout style="@style/Row">
            <TextView
                android:id="@+id/speechStatus"
                style="@style/RowText" />
            <Button
                android:id="@+id/speechButton"
                style="@style/RowButton"
                android:text="@string/download" />
        </LinearLayout>

        <!-- AI clean-up -->
        <TextView
            style="@style/Section"
            android:text="@string/section_ai" />

        <Switch
            android:id="@+id/aiSwitch"
            style="@style/Field"
            android:text="@string/ai_switch" />

        <EditText
            android:id="@+id/workerUrl"
            style="@style/Field"
            android:hint="@string/worker_url_hint"
            android:importantForAutofill="no"
            android:inputType="textUri" />

        <EditText
            android:id="@+id/appToken"
            style="@style/Field"
            android:hint="@string/token_hint"
            android:importantForAutofill="no"
            android:inputType="textPassword" />

        <Button
            android:id="@+id/testButton"
            style="@style/RowButton"
            android:layout_marginTop="8dp"
            android:text="@string/test" />

        <TextView
            android:id="@+id/testResult"
            style="@style/Hint"
            android:textIsSelectable="true" />

        <!-- Speech -->
        <TextView
            style="@style/Section"
            android:text="@string/section_speech" />

        <EditText
            android:id="@+id/language"
            style="@style/Field"
            android:hint="@string/language_hint"
            android:importantForAutofill="no"
            android:inputType="text" />

        <Switch
            android:id="@+id/onDeviceSwitch"
            style="@style/Field"
            android:text="@string/on_device_switch" />

        <Switch
            android:id="@+id/liveBarsSwitch"
            style="@style/Field"
            android:text="@string/live_bars_switch" />

        <!-- Vocabulary -->
        <TextView
            style="@style/Section"
            android:text="@string/section_words" />

        <TextView
            style="@style/Hint"
            android:text="@string/words_help" />

        <EditText
            android:id="@+id/vocabulary"
            style="@style/Field"
            android:gravity="top|start"
            android:hint="@string/words_hint"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textCapWords"
            android:minLines="3" />

        <!-- Try it -->
        <TextView
            style="@style/Section"
            android:text="@string/section_try" />

        <EditText
            android:id="@+id/tryField"
            style="@style/Field"
            android:gravity="top|start"
            android:hint="@string/try_hint"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="4" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/saveButton"
                style="@style/RowButton"
                android:text="@string/save" />

            <Button
                android:id="@+id/resetButton"
                style="@style/RowButton"
                android:layout_marginStart="12dp"
                android:text="@string/reset_position" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
